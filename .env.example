# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Database — local/dev Neon only. Do not put the production URL here.
DATABASE_URL=""
DIRECT_URL=""
DATABASE_CONNECTION_LIMIT="5"
DATABASE_POOL_TIMEOUT="10"

# Proposed session limits (confirm in TECH_CARD before applying):
# statement_timeout=10s
# idle_in_transaction_session_timeout=10s
# lock_timeout=5s

# Google Sheets via Apps Script webhook (no Cloud API / service account)
SHEETS_WEBHOOK_URL=""
SHEETS_WEBHOOK_SECRET=""
SHEETS_VISITED_TAB="Visited"
SHEETS_MISSED_TAB="Missed"

# Cron retry for Sheet sync (Vercel Cron)
CRON_SECRET=""
SHEETS_CRON_ENABLED="false"
