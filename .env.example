# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Neon — local/dev only. Do not put the production URL here.
# Neon dashboard → project → Connect → DATABASE_URL = pooled, DIRECT_URL = direct.
DATABASE_URL=""
DIRECT_URL=""
DATABASE_CONNECTION_LIMIT="5"
DATABASE_POOL_TIMEOUT="10"

# Google Sheets. Not a Vercel deploy.
# 1) You invent SHEETS_WEBHOOK_SECRET (same string in Apps Script + here).
# 2) Google gives SHEETS_WEBHOOK_URL after Apps Script → Deploy → Web app.
SHEETS_WEBHOOK_URL=""
SHEETS_WEBHOOK_SECRET=""
SHEETS_VISITED_TAB="Visited"
SHEETS_MISSED_TAB="Missed"

# Vercel Cron later. You invent CRON_SECRET. Keep false until the Sheet webhook works.
CRON_SECRET=""
SHEETS_CRON_ENABLED="false"
